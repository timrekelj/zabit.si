---
import '../styles/global.css';
import { site, nav, fmtDate } from '../data/site';

interface Props { title?: string; description?: string; }
const { title, description = site.tagline } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="sl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title ? `${title} · ${site.name}` : `${site.name} · ${site.tagline}`}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <header class="masthead">
    <div class="wrap top">
      <span class="label">Posodobljeno {fmtDate(site.updated)}</span>
      <a class="label" href="/o-nas/">Kako delamo</a>
    </div>
    <div class="wrap brand">
      <a href="/" class="wordmark">zabit<span>.si</span></a>
      <p class="tag">{site.tagline}</p>
    </div>
    <nav class="wrap" id="nav">
      <button class="menu-btn" aria-expanded="false" aria-controls="nav-list">
        <span class="cur">{nav.find((n) => path.startsWith(n.href))?.label ?? 'Domov'}</span><span class="menu-label">Meni</span>
      </button>
      <ul id="nav-list">
        {nav.map((n) => (
          <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
  </header>

  <main><slot /></main>
  <script>
    const nav = document.getElementById('nav')!;
    const btn = nav.querySelector<HTMLButtonElement>('.menu-btn')!;
    btn.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
  </script>

  <footer class="foot">
    <div class="wrap grid">
      <div>
        <a href="/" class="wordmark small">zabit<span>.si</span></a>
        <p class="small">Neodvisen projekt. Ne pripadamo nobeni stranki in nas nobena ne financira.</p>
      </div>
      <div class="small">
        <p><strong>Viri:</strong> Ustava RS, Državni zbor, Državna volilna komisija, Uradni list, programi strank. Vsako dejstvo na strani ima povezavo do vira.</p>
        <p>Napaka? Piši na <a href="mailto:popravki@zabit.si">popravki@zabit.si</a></p>
      </div>
    </div>
  </footer>
</body>
</html>

<style>
  .masthead { border-bottom: 1px solid var(--ink); }
  .top { display: flex; justify-content: space-between; padding-top: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--rule); }
  .top a { text-decoration: none; }
  .brand { display: flex; align-items: baseline; justify-content: space-between; gap: 24px; padding-top: 22px; padding-bottom: 14px; flex-wrap: wrap; }
  .wordmark {
    font-family: var(--serif); font-size: 46px; font-weight: 600; letter-spacing: -0.03em;
    font-variation-settings: 'opsz' 72; text-decoration: none; line-height: 1;
  }
  .wordmark span { font-style: italic; font-weight: 400; color: var(--ink-3); }
  .wordmark.small { font-size: 26px; }
  .tag { margin: 0; font-family: var(--serif); font-style: italic; font-size: 18px; color: var(--ink-2); }
  nav ul { display: flex; flex-wrap: wrap; gap: 4px 26px; list-style: none; margin: 0; padding: 10px 0 12px; border-top: 1px solid var(--rule); }
  nav a { font-size: 15px; font-weight: 500; text-decoration: none; padding: 2px 0; border-bottom: 2px solid transparent; }
  nav a:hover { border-color: var(--rule); }
  nav a[aria-current='page'] { border-color: var(--ink); }
  .foot { border-top: 1px solid var(--ink); margin-top: 40px; padding: 32px 0 48px; }
  .foot .grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: 32px; }
  .menu-btn { display: none; }
  @media (max-width: 720px) {
    .top .label:first-child { font-size: 11px; }
    .brand { padding-top: 16px; padding-bottom: 10px; gap: 6px; }
    .wordmark { font-size: 36px; }
    .tag { font-size: 16px; }
    .menu-btn {
      display: flex; width: 100%; justify-content: space-between; align-items: center;
      background: none; border: 0; border-top: 1px solid var(--rule); padding: 12px 0; font-size: 15px; font-weight: 600;
    }
    .menu-label { display: inline-flex; align-items: center; gap: 8px; font-weight: 500; color: var(--ink-2); }
    .menu-label::after { content: ''; width: 8px; height: 8px; border-right: 1.5px solid; border-bottom: 1.5px solid; transform: rotate(45deg) translateY(-3px); transition: transform .15s; }
    nav.open .menu-label::after { transform: rotate(-135deg) translateY(-1px); }
    nav ul { display: none; flex-direction: column; gap: 0; padding: 0 0 8px; }
    nav.open ul { display: flex; }
    nav li a { display: block; padding: 11px 0; border-bottom: 1px solid var(--rule); font-size: 16px; }
    nav li:last-child a { border-bottom: 0; }
    nav a[aria-current='page'] { border-color: var(--rule); font-weight: 700; }
    .foot .grid { grid-template-columns: 1fr; }
  }
</style>
