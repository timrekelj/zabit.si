---
import Base from '../../layouts/Base.astro';
import { all, stanceClass, isUnofficial, type Ref } from '../../data/referendumi';
import { fmtDate } from '../../data/site';

export function getStaticPaths() {
  return all.map((r) => ({ params: { slug: r.slug }, props: { r } }));
}
const { r } = Astro.props as { r: Ref };
const res = r.result;
const host = (u: string) => { try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return 'vir'; } };
---
<Base title={r.title} description={`Referendum ${fmtDate(r.date)}: vprašanje, argumenti za in proti, stališča strank.`}>
  <article class="section">
    <div class="wrap">
      <p class="label"><a href="/referendumi/">Referendumi</a> · {r.type} · {fmtDate(r.date)}</p>
      <h1 class="title">{r.title}</h1>

      <div class="ballot">
        <p class="label">Vprašanje na glasovnici</p>
        <p class="bq">»{r.question}«</p>
        <div class="boxes"><span>ZA</span><span>PROTI</span></div>
      </div>

      <div class="cols">
        <div class="main">
          <h2>Za kaj gre</h2>
          <ul class="what">{r.what.map((w) => <li>{w}</li>)}</ul>
          <p class="small">Pobudnik: {r.initiator}</p>

          <div class="outcomes">
            <div class="yes"><p class="label">Če zmaga ZA</p><p>{r.if_yes}</p></div>
            <div class="no"><p class="label">Če zmaga PROTI</p><p>{r.if_no}</p></div>
          </div>
        </div>

        {res && (
          <aside class="result">
            <p class="label">Izid{isUnofficial(r) && <span class="pill neutral unoff">Neuradni izid</span>}</p>
            <p class="outcome">{res.outcome}</p>
            <div class="bars">
              <div class="b"><span>Za</span><div class="t"><i class="y" style={`width:${res.yes}%`}></i></div><span class="num">{res.yes.toLocaleString('sl-SI')} %</span></div>
              <div class="b"><span>Proti</span><div class="t"><i class="n" style={`width:${res.no}%`}></i></div><span class="num">{res.no.toLocaleString('sl-SI')} %</span></div>
            </div>
            <p class="small num">Udeležba: {res.turnout.toLocaleString('sl-SI')} %</p>
            {res.quorum_met !== null ? (
              <p class="small">Zavrnitveni kvorum (proti vsaj 20 % vseh volivcev): <strong>{res.quorum_met ? 'dosežen' : 'ni dosežen'}</strong></p>
            ) : (
              <p class="small">Posvetovalni referendum: izid ni pravno zavezujoč, kvorum ne velja.</p>
            )}
            {isUnofficial(r) && <p class="small">Državna volilna komisija končnega izida še ni objavila. Številke posodobimo, ko bo.</p>}
            {res.src && <p class="small"><a href={res.src} target="_blank" rel="noopener">Izid na strani DVK</a></p>}
          </aside>
        )}
      </div>

      <h2 class="sec">Argumenti</h2>
      <p class="small">Najmočnejši argumenti, kot so jih predstavile strani v kampanji. Vrstni red ne pomeni teže.</p>
      <div class="args">
        <section>
          <h3 class="yes-h">Za</h3>
          <ol>{r.for.map((a) => <li><p>{a.arg}</p><p class="by small">{a.by} · <a href={a.src} target="_blank" rel="noopener">{host(a.src)}</a></p></li>)}</ol>
        </section>
        <section>
          <h3 class="no-h">Proti</h3>
          <ol>{r.against.map((a) => <li><p>{a.arg}</p><p class="by small">{a.by} · <a href={a.src} target="_blank" rel="noopener">{host(a.src)}</a></p></li>)}</ol>
        </section>
      </div>

      {r.aftermath && (
        <>
          <h2 class="sec">Po referendumu</h2>
          <p class="after narrow">{r.aftermath}</p>
        </>
      )}

      <h2 class="sec">Stališča strank</h2>
      <table class="parties">
        <tbody>
          {[...r.parties].sort((a, b) => a.party.localeCompare(b.party, 'sl')).map((p) => (
            <tr>
              <th>{p.party}</th>
              <td><span class={`pill ${stanceClass(p.stance)}`}>{p.stance}</span></td>
              <td class="small">{p.note}{p.src && <> <a href={p.src} target="_blank" rel="noopener">{host(p.src)}</a></>}</td>
            </tr>
          ))}
        </tbody>
      </table>

      {r.unverified && r.unverified.length > 0 && (
        <>
          <h2 class="sec">Česa še nismo preverili</h2>
          <ul class="unv small">{r.unverified.map((u) => <li>{u}</li>)}</ul>
        </>
      )}

      <h2 class="sec">Viri</h2>
      <ul class="src small">{r.sources.map((s) => <li><a href={s} target="_blank" rel="noopener">{s}</a></li>)}</ul>
    </div>
  </article>
</Base>

<style>
  .label a { text-decoration: none; }
  .title { max-width: 18em; margin: 10px 0 28px; }
  .ballot { border: 1px solid var(--ink); background: #fffefb; padding: 22px 26px; max-width: 820px; position: relative; }
  .bq { font-family: var(--serif); font-size: clamp(1.25rem, 2.4vw, 1.6rem); line-height: 1.35; margin: 8px 0 18px; }
  .boxes { display: flex; gap: 28px; }
  .boxes span { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; font-size: 14px; letter-spacing: .06em; }
  .boxes span::before { content: ''; width: 22px; height: 22px; border: 1.5px solid var(--ink); border-radius: 50%; }
  .cols { display: grid; grid-template-columns: 1fr 320px; gap: 48px; margin-top: 48px; align-items: start; }
  .main h2, .sec { margin-bottom: 14px; }
  .what { padding-left: 1.1em; margin: 0 0 14px; font-family: var(--serif); font-size: 1.15rem; }
  .what li { margin-bottom: 8px; }
  .outcomes { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 24px; }
  .outcomes > div { padding: 16px 18px; border-radius: 6px; }
  .outcomes .yes { background: var(--yes-bg); }
  .outcomes .no { background: var(--no-bg); }
  .outcomes .yes .label { color: var(--yes); }
  .outcomes .no .label { color: var(--no); }
  .outcomes p:last-child { margin: 6px 0 0; }
  .result { border-top: 1px solid var(--ink); padding-top: 12px; }
  .outcome { font-family: var(--serif); font-size: 1.5rem; line-height: 1.2; margin: 6px 0 16px; }
  .bars { display: grid; gap: 10px; margin-bottom: 14px; }
  .b { display: grid; grid-template-columns: 44px 1fr 62px; gap: 10px; align-items: center; font-size: 14px; }
  .b .num { text-align: right; }
  .t { height: 12px; background: var(--paper-deep); border-radius: 999px; overflow: hidden; }
  .t i { display: block; height: 100%; }
  .t .y { background: var(--yes); }
  .t .n { background: var(--no); }
  .after { font-family: var(--serif); font-size: 1.1rem; }
  .sec { margin-top: 64px; }
  .args { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-top: 20px; }
  .args h3 { font-family: var(--sans); font-size: 14px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; padding-bottom: 8px; border-bottom: 2px solid; }
  .yes-h { color: var(--yes); }
  .no-h { color: var(--no); }
  .args ol { list-style: none; margin: 0; padding: 0; }
  .args li { padding: 14px 0; border-bottom: 1px solid var(--rule); }
  .args li p:first-child { font-family: var(--serif); font-size: 1.12rem; margin: 0 0 4px; }
  .by { margin: 0; color: var(--ink-3); }
  .parties { border-collapse: collapse; width: 100%; max-width: 820px; border-top: 1px solid var(--ink); }
  .parties th { text-align: left; font-weight: 600; padding: 10px 16px 10px 0; width: 120px; border-bottom: 1px solid var(--rule); }
  .parties td { padding: 10px 16px 10px 0; border-bottom: 1px solid var(--rule); vertical-align: baseline; }
  .parties td:nth-child(2) { width: 150px; }
  .src { padding-left: 1.1em; word-break: break-all; }
  .unv { padding-left: 1.1em; max-width: 44rem; }
  .unoff { margin-left: 8px; text-transform: none; letter-spacing: 0; }
  @media (max-width: 860px) {
    .cols, .args, .outcomes { grid-template-columns: 1fr; }
    .parties td:last-child { display: none; }
  }
</style>
