---
import Base from '../../layouts/Base.astro';
import RefCard from '../../components/RefCard.astro';
import { latest, upcoming, archive } from '../../data/referendumi';
import { fmtDate } from '../../data/site';
---
<Base title="Referendumi" description="Vsi slovenski referendumi: vprašanja, argumenti za in proti, stališča strank in izidi.">
  <section class="section">
    <div class="wrap">
      <p class="label">Referendumi</p>
      <h1>O čem smo glasovali in zakaj</h1>
      <p class="dek narrow">Za vsak referendum: točno vprašanje na glasovnici, kaj se spremeni ob izidu ZA ali PROTI, najmočnejši argumenti obeh strani in stališča strank.</p>

      {upcoming.length > 0 && (
        <div class="block">
          <h2 class="h">Prihajajoči</h2>
          {upcoming.map((r) => <RefCard r={r} big />)}
        </div>
      )}

      <div class="block">
        <h2 class="h">{latest.length > 1 ? 'Zadnji referendumi' : 'Zadnji referendum'}</h2>
        <div class="grid">{latest.map((r, i) => <RefCard r={r} big={latest.length === 1} />)}</div>
      </div>

      {archive.length > 0 && (
        <div class="block">
          <h2 class="h">Arhiv</h2>
          <table>
            <thead><tr><th>Datum</th><th>Tema</th><th>Izid</th><th class="r">Udeležba</th></tr></thead>
            <tbody>
              {archive.map((a) => (
                <tr>
                  <td class="num nowrap">{fmtDate(a.date)}</td>
                  <td><a href={a.src} target="_blank" rel="noopener">{a.topic}</a></td>
                  <td>{a.outcome}</td>
                  <td class="r num">{a.turnout == null ? '–' : a.turnout.toLocaleString('sl-SI') + ' %'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </section>
</Base>
<style>
  .block { margin-top: 48px; }
  .h { font-size: 1.1rem; font-family: var(--sans); font-weight: 600; letter-spacing: .06em; text-transform: uppercase; margin-bottom: 4px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); column-gap: 32px; }
  table { width: 100%; border-collapse: collapse; font-size: 15px; margin-top: 8px; }
  th { text-align: left; font-size: 12px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-3); border-bottom: 1px solid var(--ink); padding: 8px 12px 8px 0; }
  td { border-bottom: 1px solid var(--rule); padding: 10px 12px 10px 0; vertical-align: top; }
  .r { text-align: right; padding-right: 0; }
  .nowrap { white-space: nowrap; }
</style>
