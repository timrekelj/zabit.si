---
import Base from '../layouts/Base.astro';
import { governments, endings } from '../data/content';
const tally = Object.entries(endings)
  .map(([k, label]) => ({ k, label, n: governments.filter((g) => g[2] === k).length }))
  .filter((t) => t.n && t.k !== 'cur');
---
<Base title="Vlade od 1990" description="Vse slovenske vlade od leta 1990 in kako se je končala vsaka.">
  <section class="section">
    <div class="wrap">
      <p class="label">Zgodovina</p>
      <h1>Kako se končajo vlade</h1>
      <p class="dek narrow">Vsaka vlada od prvih demokratičnih volitev leta 1990 in razlog, zakaj se je končala. Vir za leto 2026: Državni zbor, gov.si.</p>

      <dl class="tally">
        {tally.map((t) => <div><dt class="label">{t.label}</dt><dd class="num">{t.n}</dd></div>)}
      </dl>

      <ol class="tl">
        {governments.map(([yr, who, end, note]) => (
          <li>
            <span class="yr num">{yr}</span>
            <span><strong>{who}</strong><br /><span class="small">{note}</span></span>
            <span class={`pill ${end === 'cur' ? 'yes' : end === 'vol' || end === 'ods' ? 'neutral' : 'no'}`}>{endings[end]}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap pattern">
      <div>
        <p class="label">Vzorec</p>
        <h2>Nova stranka na vrhu</h2>
        <p class="narrow">Na volitvah 2011, 2014, 2018 in 2022 je prvo mesto ali mandat za sestavo vlade dobila stranka, ki na prejšnjih parlamentarnih volitvah ni kandidirala: Pozitivna Slovenija, SMC, LMŠ in Gibanje Svoboda. Na volitvah 2026 se je vzorec prekinil: prvo mesto je ohranila Svoboda, vlado pa je sestavil Janez Janša.</p>
      </div>
      <ol class="faces">
        <li><span class="num">2011</span> Pozitivna Slovenija</li>
        <li><span class="num">2014</span> Stranka Mira Cerarja</li>
        <li><span class="num">2018</span> Lista Marjana Šarca</li>
        <li><span class="num">2022</span> Gibanje Svoboda</li>
      </ol>
    </div>
  </section>
</Base>

<style>
  .tally { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0; margin: 36px 0; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--rule); }
  .tally div { padding: 14px 16px 14px 0; }
  .tally dd { margin: 4px 0 0; font-family: var(--serif); font-size: 40px; line-height: 1; }
  .tl { list-style: none; margin: 0; padding: 0; }
  .tl li { display: grid; grid-template-columns: 120px 1fr auto; gap: 20px; align-items: baseline; padding: 14px 0; border-bottom: 1px solid var(--rule); }
  .yr { font-family: var(--serif); font-size: 1.15rem; }
  .pattern { display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; align-items: center; }
  .pattern h2 { margin-bottom: 14px; }
  .faces { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  .faces li { font-family: var(--serif); font-size: 1.35rem; padding: 10px 0; border-bottom: 1px solid var(--rule); }
  .faces span { font-family: var(--sans); font-size: 14px; color: var(--ink-3); display: inline-block; width: 56px; }
  @media (max-width: 720px) {
    .tl li { grid-template-columns: 1fr auto; }
    .tl li > span:nth-child(2) { grid-column: 1 / -1; grid-row: 2; }
    .pattern { grid-template-columns: 1fr; }
  }
</style>
