---
import Base from '../layouts/Base.astro';
import l from '../data/lokalne-2026.json';
import { fmtDate } from '../data/site';
const host = (u: string) => { try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return 'vir'; } };
---
<Base title="Lokalne volitve 2026" description="Kdaj, kaj in kako volimo na lokalnih volitvah 15. novembra 2026.">
  <article class="section">
    <div class="wrap">
      <p class="label">Volitve · {fmtDate(l.round1)}</p>
      <h1>Lokalne volitve 2026</h1>
      <p class="dek narrow">V {l.municipalities} občinah volimo župane in občinske svetnike. Kdo lahko voli, kaj je novega in kako glasovati, če na dan volitev ne moreš na volišče.</p>

      <dl class="dates">
        <div><dt class="label">Prvi krog</dt><dd>{fmtDate(l.round1)}</dd></div>
        {l.round2 && <div><dt class="label">Drugi krog za župane</dt><dd>{fmtDate(l.round2)}</dd></div>}
        <div><dt class="label">Občin</dt><dd class="num">{l.municipalities}</dd></div>
      </dl>

      <div class="cols">
        <section>
          <h2>Kaj volimo</h2>
          <ul class="list">{l.elected.map((e) => <li>{e}</li>)}</ul>

          <h2 class="sec">Kdo lahko voli</h2>
          <p class="body">{l.who_can_vote}</p>

          <h2 class="sec">Kaj je novega: volilna pravica tujcev</h2>
          <p class="body">{l.foreigners_change.law}</p>
          <p class="body">{l.foreigners_change.court_status}</p>
          <p class="small">
            Velja od {fmtDate(l.foreigners_change.in_force)} ·
            <a href={l.foreigners_change.src} target="_blank" rel="noopener">{host(l.foreigners_change.src)}</a>
            {l.foreigners_change.src_more.map((u) => <> · <a href={u} target="_blank" rel="noopener">{host(u)}</a></>)}
          </p>
          <p class="small"><a href="/referendumi/volilna-pravica-tujcev-2026/">Posvetovalni referendum o tej temi</a></p>
        </section>

        <aside>
          <h2>Kako glasovati</h2>
          <ol class="how">
            {l.how_to_vote.map((h) => <li><p>{h.point}</p><a class="small" href={h.src} target="_blank" rel="noopener">{host(h.src)}</a></li>)}
          </ol>
        </aside>
      </div>

      <h2 class="sec">Dobro je vedeti</h2>
      <ul class="facts">
        {l.facts.map((f) => <li><p>{f.fact}</p><a class="small" href={f.src} target="_blank" rel="noopener">{host(f.src)}</a></li>)}
      </ul>

      <h2 class="sec">Viri</h2>
      <ul class="src small">{l.src.map((s) => <li><a href={s} target="_blank" rel="noopener">{s}</a></li>)}</ul>
    </div>
  </article>
</Base>

<style>
  .dates { display: grid; grid-template-columns: repeat(3, 1fr); margin: 36px 0 48px; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--rule); }
  .dates div { padding: 14px 16px 14px 0; }
  .dates dd { margin: 4px 0 0; font-family: var(--serif); font-size: 1.6rem; line-height: 1.1; }
  .cols { display: grid; grid-template-columns: 1fr 360px; gap: 56px; align-items: start; }
  h2 { margin-bottom: 14px; }
  .sec { margin-top: 48px; }
  .list { padding-left: 1.1em; margin: 0; font-family: var(--serif); font-size: 1.12rem; }
  .list li { margin-bottom: 8px; }
  .body { font-family: var(--serif); font-size: 1.12rem; max-width: var(--measure); }
  .how, .facts { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  .how li, .facts li { padding: 12px 0; border-bottom: 1px solid var(--rule); }
  .how p, .facts p { margin: 0 0 4px; }
  .how a, .facts a { color: var(--ink-3); }
  .facts { max-width: 820px; }
  .facts p { font-family: var(--serif); font-size: 1.08rem; }
  .src { padding-left: 1.1em; word-break: break-all; }
  @media (max-width: 860px) {
    .cols { grid-template-columns: 1fr; gap: 32px; }
    .dates { grid-template-columns: 1fr 1fr; }
  }
</style>
