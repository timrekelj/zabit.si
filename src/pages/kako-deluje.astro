---
import Base from '../layouts/Base.astro';
import { institutions } from '../data/content';
---
<Base title="Kako deluje država" description="Kdo v Sloveniji kaj odloča in kako nastane zakon.">
  <section class="section">
    <div class="wrap">
      <p class="label">Razlaga</p>
      <h1>Kdo v Sloveniji kaj odloča?</h1>
      <p class="dek narrow">Devet ustanov, ki jih omenjajo poročila. Za vsako: kaj dela, česa ne more in zakaj je pomembna.</p>

      <div class="inst">
        <ul class="list" role="tablist">
          {institutions.map((i, k) => (
            <li>
              <button role="tab" aria-selected={k === 1 ? 'true' : 'false'} data-id={i.id}>
                <span class="n num">{i.n}</span><span class="t">{i.t}</span>
              </button>
            </li>
          ))}
        </ul>
        <div>
          {institutions.map((i, k) => (
            <article class="detail" data-for={i.id} hidden={k !== 1}>
              <h2>{i.t}</h2>
              <p class="small meta">{i.meta}</p>
              <dl>
                <div><dt class="label">Kaj dela</dt><dd>{i.does}</dd></div>
                <div><dt class="label">Česa ne more</dt><dd>{i.cant}</dd></div>
                <div><dt class="label">Zakaj je pomembno</dt><dd>{i.why}</dd></div>
              </dl>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="zakon">
    <div class="wrap">
      <p class="label">Interaktivno</p>
      <h2>Od ideje do zakona</h2>
      <p class="dek narrow">Pelji predlog skozi Državni zbor, Državni svet, morebitni referendum in razglasitev. Nekatere odločitve sprejmeš sam, nekatere so odvisne od sreče, tako kot v resnici.</p>
      <div class="panel bill" id="bill"></div>
    </div>
  </section>
</Base>

<style>
  .inst { display: grid; grid-template-columns: 300px 1fr; gap: 40px; margin-top: 36px; align-items: start; }
  .list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  .list li { border-bottom: 1px solid var(--rule); }
  .list button {
    width: 100%; display: grid; grid-template-columns: 96px 1fr; align-items: baseline; gap: 12px;
    background: none; border: 0; padding: 11px 4px; text-align: left;
  }
  .list button:hover .t { text-decoration: underline; text-underline-offset: 3px; }
  .list .n { font-family: var(--serif); font-size: 20px; color: var(--ink-3); }
  .list .t { font-weight: 500; }
  .list button[aria-selected='true'] { background: var(--paper-deep); }
  .list button[aria-selected='true'] .n { color: var(--ink); }
  .detail h2 { margin-bottom: 6px; }
  .meta { margin-bottom: 24px; }
  dl { margin: 0; display: grid; gap: 20px; }
  dl div { border-top: 1px solid var(--rule); padding-top: 12px; display: grid; grid-template-columns: 170px 1fr; gap: 16px; }
  dd { margin: 0; font-family: var(--serif); font-size: 1.15rem; line-height: 1.45; }
  .bill { margin-top: 28px; max-width: 760px; }
  @media (max-width: 820px) {
    .inst { grid-template-columns: 1fr; gap: 24px; }
    dl div { grid-template-columns: 1fr; gap: 4px; }
  }
</style>

<style is:global>
  .bill .steps { display: flex; gap: 0; margin-bottom: 22px; font-size: 12px; font-weight: 600; color: var(--ink-3); flex-wrap: wrap; }
  .bill .steps span { padding: 4px 10px 4px 0; margin-right: 10px; border-bottom: 2px solid var(--rule); }
  .bill .steps span.done { color: var(--ink); border-color: var(--ink); }
  .bill .txt { font-family: var(--serif); font-size: 1.3rem; line-height: 1.45; margin-bottom: 8px; }
  .bill .fact { font-size: 15px; color: var(--ink-2); margin-bottom: 22px; }
  .bill .roll { font-family: var(--sans); font-size: 13px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; display: block; margin-bottom: 6px; }
  .bill .end { font-family: var(--serif); font-size: 2rem; margin-bottom: 8px; }
  .bill .end.win { color: var(--yes); }
  .bill .end.lose { color: var(--no); }
  .bill .row { display: flex; gap: 10px; flex-wrap: wrap; }
</style>

<script>
  // Institution switcher
  const tabs = document.querySelectorAll<HTMLButtonElement>('.list button');
  tabs.forEach((b) => b.addEventListener('click', () => {
    tabs.forEach((x) => x.setAttribute('aria-selected', String(x === b)));
    document.querySelectorAll<HTMLElement>('.detail').forEach((d) => (d.hidden = d.dataset.for !== b.dataset.id));
    if (window.matchMedia('(max-width: 820px)').matches) {
      document.querySelector<HTMLElement>(`.detail[data-for="${b.dataset.id}"]`)!.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }));

  // Bill game
  type S = { support: number; cheap: boolean };
  type Node = {
    stage: number; text: string | ((s: S) => string); fact?: string;
    end?: 'win' | 'lose'; title?: string; next?: string;
    choices?: [string, (s: S) => string][];
    roll?: (s: S) => { ok: boolean; yes: string; no: string }; okLabel?: string; noLabel?: string;
  };
  const STAGES = ['Ideja', 'Predlog', 'Odbor', 'Glasovanje', 'Državni svet', 'Referendum', 'Razglasitev'];
  const N: Record<string, Node> = {
    start: { stage: 0, text: 'Želiš, da bi bil javni prevoz za upokojence, dijake in študente brezplačen. Kako spraviš idejo v zakon?',
      choices: [
        ['Prepričam vlado', (s) => { s.support = 0.75; return 'vlada'; }],
        ['Obrnem se na poslanca', (s) => { s.support = 0.45; return 'poslanec'; }],
        ['Zberem 5.000 podpisov', (s) => { s.support = 0.5; return 'podpisi'; }],
        ['Napišem objavo na družbenih omrežjih', () => 'objava'],
      ] },
    objava: { stage: 0, end: 'lose', title: 'Zakon ni nastal.', text: 'Objava je dobila veliko odzivov, zakon pa nobenega člena.',
      fact: 'Zakon lahko predlagajo vlada, vsak poslanec, Državni svet ali 5.000 volivcev. Javna podpora pomaga, ni pa uradni predlog.' },
    vlada: { stage: 1, text: 'Ministrstvo pripravi besedilo, vlada ga potrdi in pošlje v Državni zbor.',
      fact: 'Vlada predlaga večino zakonov, ker ima za sabo koalicijo in strokovne službe ministrstev.', next: 'odbor' },
    poslanec: { stage: 1, text: 'Poslanec, ki mu je ideja všeč, vloži predlog zakona. Je iz opozicije.',
      fact: 'Vsak poslanec lahko vloži zakon. Brez podpore koalicije pa redko pride skozi.', next: 'odbor' },
    podpisi: { stage: 1, text: 'Zbereš 5.000 podpisov in predlog vložiš v Državni zbor.',
      fact: 'Ljudska zakonodajna pobuda je redka, a mogoča.', next: 'odbor' },
    odbor: { stage: 2, text: 'Predlog obravnava pristojni odbor. Nekdo predlaga amandma: brezplačno samo za upokojence in dijake, da bo ceneje.',
      fact: 'Amandma je predlog spremembe. Na odboru se zakon pogosto spremeni najbolj.',
      choices: [
        ['Sprejmem amandma', (s) => { s.support += 0.12; s.cheap = true; return 'finance'; }],
        ['Vztrajam pri prvotnem predlogu', (s) => { s.support -= 0.05; return 'finance'; }],
      ] },
    finance: { stage: 2, text: (s) => `Ministrstvo za finance vpraša, kdo bo to plačal. Ocena stroškov: ${s.cheap ? 'nekaj deset milijonov' : 'precej več'} evrov na leto.`,
      fact: 'Predlog, ki stane denar, mora povedati, od kod bo ta denar prišel.',
      choices: [
        ['Predlagam rebalans proračuna', (s) => { s.support -= 0.03; return 'glas'; }],
        ['Prerazporedim denar z drugih postavk', (s) => { s.support += 0.02; return 'glas'; }],
      ] },
    glas: { stage: 3, text: 'Glasovanje na seji Državnega zbora.',
      fact: 'Za navaden zakon zadostuje večina glasov navzočih poslancev, če je navzočih vsaj 46.',
      roll: (s) => ({ ok: Math.random() < s.support, yes: 'ds', no: 'padel' }), okLabel: 'Sprejet', noLabel: 'Zavrnjen' },
    padel: { stage: 3, end: 'lose', title: 'Zakon ni dobil večine.', text: 'Premalo poslancev je glasovalo za.',
      fact: 'Tako se konča večina predlogov opozicije, ne glede na to, katere stranke so v opoziciji.' },
    ds: { stage: 4, text: 'Državni svet ima 7 dni, da izglasuje odložilni veto.',
      fact: 'Veto zakona ne ustavi, ampak zahteva ponovno glasovanje, kjer je potrebnih 46 glasov.',
      roll: () => ({ ok: Math.random() < 0.7, yes: 'ref', no: 'veto' }), okLabel: 'Brez veta', noLabel: 'Veto' },
    veto: { stage: 4, text: 'Državni svet je izglasoval veto. Zakon potrebuje vsaj 46 glasov za.',
      roll: (s) => ({ ok: Math.random() < s.support - 0.1, yes: 'ref', no: 'vetoPadel' }), okLabel: 'Veto preglasovan', noLabel: 'Veto obvelja' },
    vetoPadel: { stage: 4, end: 'lose', title: 'Veto je obveljal.', text: 'Pri ponovnem glasovanju je zmanjkalo glasov do 46.',
      fact: 'Prvič zadostuje večina navzočih, drugič je potrebna večina vseh poslancev.' },
    ref: { stage: 5, text: 'Nasprotniki imajo 35 dni, da zberejo 40.000 podpisov za referendum.',
      fact: 'Referenduma ni mogoče razpisati o davkih, proračunu, ratifikaciji mednarodnih pogodb in nekaterih drugih zakonih.',
      roll: () => ({ ok: Math.random() < 0.75, yes: 'razgl', no: 'refVote' }), okLabel: 'Premalo podpisov', noLabel: 'Referendum bo' },
    refVote: { stage: 5, text: 'Volivci odločajo. Zakon je zavrnjen, če je večina proti in je proti glasovalo vsaj 20 % vseh volivcev.',
      roll: () => ({ ok: Math.random() < 0.55, yes: 'razgl', no: 'refPadel' }), okLabel: 'Zakon potrjen', noLabel: 'Zakon zavrnjen' },
    refPadel: { stage: 5, end: 'lose', title: 'Zakon je bil zavrnjen na referendumu.', text: 'Proti je glasovalo dovolj volivcev.',
      fact: 'Državni zbor eno leto ne sme sprejeti zakona z enako vsebino.' },
    razgl: { stage: 6, end: 'win', title: 'Zakon je sprejet.', text: 'Predsednik republike ga razglasi, objavi se v Uradnem listu in praviloma začne veljati 15. dan po objavi.',
      fact: 'Predsednik zakona ne more zavrniti; razglasiti ga mora v 8 dneh. Kdor izkaže pravni interes, ga lahko še izpodbija na Ustavnem sodišču.' },
  };

  const el = document.getElementById('bill')!;
  let s: S = { support: 0.5, cheap: false };
  const btn = (label: string, cls: string, fn: () => void) => {
    const b = document.createElement('button');
    b.className = cls; b.textContent = label; b.onclick = fn; return b;
  };
  function render(id: string, roll = '') {
    const n = N[id];
    const text = typeof n.text === 'function' ? n.text(s) : n.text;
    el.innerHTML = `<div class="steps">${STAGES.map((x, i) => `<span class="${i <= n.stage ? 'done' : ''}">${x}</span>`).join('')}</div>
      ${n.end ? `<div class="end ${n.end}">${n.title}</div>` : ''}
      <div class="txt">${roll ? `<span class="roll">${roll}</span>` : ''}${text}</div>
      ${n.fact ? `<p class="fact">${n.fact}</p>` : ''}<div class="row"></div>`;
    const row = el.querySelector('.row')!;
    if (n.end) row.append(btn('Začni znova', 'btn', start));
    else if (n.choices) n.choices.forEach(([l, f]) => row.append(btn(l, 'btn line', () => render(f(s)))));
    else if (n.roll) row.append(btn('Glasuj', 'btn', () => {
      const r = n.roll!(s);
      render(r.ok ? r.yes : r.no, r.ok ? n.okLabel! : n.noLabel!);
    }));
    else if (n.next) row.append(btn('Naprej', 'btn arrow', () => render(n.next!)));
  }
  function start() { s = { support: 0.5, cheap: false }; render('start'); }
  start();
</script>
