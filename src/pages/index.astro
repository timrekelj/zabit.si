---
import Base from '../layouts/Base.astro';
import ClaudeLogo from '../components/ClaudeLogo.astro';
---
<Base title="Claude je zabit · zabit.si" description="Claude je zabit. Vsaj tako pravi domena.">
  <section class="hero">
    <ClaudeLogo size={180} />
    <h1>Claude je <em>zabit</em>.</h1>
    <p class="sub">Vsaj tako pravi domena.</p>
    <p class="wordmark">zabit<span>.si</span></p>
  </section>
</Base>

<style>
  .hero {
    min-height: 100vh; min-height: 100svh;
    display: grid; place-content: center; justify-items: center; text-align: center;
    padding: 24px; color: #d97757;
  }
  .hero :global(svg) { width: clamp(120px, 30vw, 180px); height: auto; margin-bottom: 32px; }
  h1 {
    margin: 0; color: var(--ink);
    font-family: var(--serif); font-size: clamp(2.6rem, 8vw, 4.5rem); font-weight: 600;
    letter-spacing: -0.03em; line-height: 1; font-variation-settings: 'opsz' 72;
  }
  h1 em { font-weight: 400; }
  .sub { margin: 14px 0 0; font-family: var(--serif); font-style: italic; font-size: 1.2rem; color: var(--ink-2); }
  .wordmark {
    margin: 56px 0 0; padding-top: 14px; border-top: 1px solid var(--rule); color: var(--ink);
    font-family: var(--serif); font-size: 22px; font-weight: 600; letter-spacing: -0.03em; line-height: 1;
  }
  .wordmark span { font-style: italic; font-weight: 400; color: var(--ink-3); }
</style>
