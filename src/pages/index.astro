---
import Base from '../layouts/Base.astro';
import ClaudeLogo from '../components/ClaudeLogo.astro';
---
<Base title="zabit.si">
  <section class="hero">
    <ClaudeLogo size={180} />
    <p class="wordmark">zabit<span>.si</span></p>
  </section>
</Base>

<style>
  .hero {
    min-height: 100vh; min-height: 100svh;
    display: grid; place-content: center; justify-items: center; gap: 28px;
    padding: 24px; color: #d97757;
  }
  .hero :global(svg) { width: clamp(120px, 30vw, 180px); height: auto; }
  .wordmark {
    margin: 0; color: var(--ink);
    font-family: var(--serif); font-size: 40px; font-weight: 600; letter-spacing: -0.03em;
    font-variation-settings: 'opsz' 72; line-height: 1;
  }
  .wordmark span { font-style: italic; font-weight: 400; color: var(--ink-3); }
</style>
