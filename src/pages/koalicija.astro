---
import Base from '../layouts/Base.astro';
import { elections } from '../data/content';
---
<Base title="Sestavi koalicijo" description="Sestavi vlado z vsaj 46 poslanci na podlagi pravih volilnih rezultatov.">
  <section class="section">
    <div class="wrap">
      <p class="label">Interaktivno</p>
      <h1>Sestavi koalicijo</h1>
      <p class="dek narrow">Nobena stranka v samostojni Sloveniji ni sama dobila večine. Za izvolitev predsednika vlade je potrebnih 46 od 90 glasov. Izberi volitve, sestavi večino in primerjaj z resničnim izidom.</p>

      <div class="tabs" role="tablist">
        {Object.keys(elections).map((y) => <button role="tab" data-year={y} aria-selected={y === '2026' ? 'true' : 'false'}>Volitve {y}</button>)}
      </div>

      <div class="coal">
        <ul class="parties" id="parties"></ul>
        <div class="panel side">
          <svg id="hemi" viewBox="0 0 360 192" role="img" aria-label="Sedežni red Državnega zbora"></svg>
          <p class="meter num"><span id="sum">0</span><span class="of"> od 46 potrebnih</span></p>
          <p class="verdict" id="verdict"></p>
          <details>
            <summary>Kaj se je zgodilo v resnici</summary>
            <p id="truth"></p>
          </details>
        </div>
      </div>
      <p class="small note">Sedeži so obarvani samo glede na to, ali so v koaliciji. Stranke so razvrščene po številu sedežev. Vir: Državna volilna komisija.</p>
    </div>
  </section>
</Base>

<script is:inline define:vars={{ elections }}>
  window.__ELECTIONS = elections;
</script>

<script>
  const E = (window as any).__ELECTIONS as Record<string, { parties: [string, string, number][]; truth: string }>;
  let year = '2026';
  const sel = new Set<string>();

  // 90 seat positions in 6 arcs, ordered left to right
  const seats = (() => {
    const radii = Array.from({ length: 6 }, (_, i) => 70 + i * 18);
    const tot = radii.reduce((a, b) => a + b, 0);
    const counts = radii.map((r) => Math.round((90 * r) / tot));
    counts[5] += 90 - counts.reduce((a, b) => a + b, 0);
    const pts: { x: number; y: number; a: number }[] = [];
    radii.forEach((r, i) => {
      for (let k = 0; k < counts[i]; k++) {
        const a = Math.PI - (Math.PI * k) / (counts[i] - 1);
        pts.push({ x: 180 + r * Math.cos(a), y: 178 - r * Math.sin(a), a });
      }
    });
    return pts.sort((p, q) => q.a - p.a);
  })();

  function verdict(sum: number, n: number, all: number) {
    if (n === 0) return 'Izberi stranke, ki bi skupaj sestavile vlado.';
    if (n === all) return 'Vse stranke skupaj ne bi pustile nikogar v opoziciji.';
    let m = '';
    if (sum < 46) m = `Do večine manjka ${46 - sum} glasov. Manjšinska vlada je mogoča, a potrebuje stalno podporo strank zunaj koalicije.`;
    else if (sum >= 60) m = `${sum} glasov je dvotretjinska večina, s katero bi lahko spreminjali ustavo.`;
    else if (n === 1) m = 'Ena stranka z lastno večino. V samostojni Sloveniji se to še ni zgodilo.';
    else m = `Večina s ${n} partnerji. Več partnerjev pomeni več usklajevanja pri vsaki odločitvi.`;
    if (sel.has('NS')) m += ' Poslanca narodnih skupnosti običajno ne vstopita v koalicijo, ampak z vlado podpišeta sporazum o sodelovanju.';
    return m;
  }

  function render() {
    const { parties, truth } = E[year];
    const ul = document.getElementById('parties')!;
    ul.innerHTML = '';
    for (const [ab, name, n] of parties) {
      const li = document.createElement('li');
      li.innerHTML = `<button aria-pressed="${sel.has(ab)}"><span class="box"></span><span><b>${ab}</b><small>${name}</small></span><span class="n num">${n}</span></button>`;
      li.querySelector('button')!.onclick = () => { sel.has(ab) ? sel.delete(ab) : sel.add(ab); render(); };
      ul.append(li);
    }
    const flags: boolean[] = [];
    parties.forEach(([ab, , n]) => { for (let i = 0; i < n; i++) flags.push(sel.has(ab)); });
    document.getElementById('hemi')!.innerHTML = seats.map((p, i) =>
      `<circle cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="6.2" fill="${flags[i] ? '#1b1a17' : '#fffefb'}" stroke="${flags[i] ? '#1b1a17' : '#b9b2a3'}" stroke-width="1.2"/>`).join('');
    const sum = parties.filter((p) => sel.has(p[0])).reduce((a, p) => a + p[2], 0);
    const s = document.getElementById('sum')!;
    s.textContent = String(sum);
    s.classList.toggle('ok', sum >= 46);
    document.getElementById('verdict')!.textContent = verdict(sum, sel.size, parties.length);
    document.getElementById('truth')!.textContent = truth;
  }

  document.querySelectorAll<HTMLButtonElement>('.tabs button').forEach((b) => b.addEventListener('click', () => {
    year = b.dataset.year!; sel.clear();
    document.querySelectorAll('.tabs button').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
    render();
  }));
  render();
</script>

<style>
  .tabs { display: flex; gap: 6px; margin: 32px 0 20px; flex-wrap: wrap; }
  .tabs button { background: none; border: 1px solid var(--rule); border-radius: 999px; padding: 6px 14px; font-size: 14px; font-weight: 500; }
  .tabs button[aria-selected='true'] { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .coal { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: start; }
  .side { position: sticky; top: 16px; }
  .meter { text-align: center; margin: 10px 0 4px; }
  #sum { font-family: var(--serif); font-size: 56px; line-height: 1; }
  #sum.ok { color: var(--yes); }
  .of { color: var(--ink-3); font-size: 15px; }
  .verdict { text-align: center; font-size: 15px; color: var(--ink-2); min-height: 4.6em; }
  details { border-top: 1px solid var(--rule); padding-top: 12px; }
  summary { cursor: pointer; font-weight: 600; font-size: 15px; }
  details p { margin: 10px 0 0; font-family: var(--serif); font-size: 1.1rem; }
  .note { margin-top: 20px; }
</style>
<style is:global>
  .parties { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  .parties li { border-bottom: 1px solid var(--rule); }
  .parties button { width: 100%; display: grid; grid-template-columns: 20px 1fr auto; gap: 14px; align-items: center; background: none; border: 0; padding: 12px 4px; text-align: left; }
  .parties button:hover { background: var(--paper-deep); }
  .parties .box { width: 16px; height: 16px; border: 1.5px solid var(--ink); border-radius: 3px; }
  .parties button[aria-pressed='true'] .box { background: var(--ink); box-shadow: inset 0 0 0 2px var(--paper); }
  .parties b { display: block; font-weight: 600; }
  .parties small { color: var(--ink-3); font-size: 13px; }
  .parties .n { font-family: var(--serif); font-size: 26px; }
  @media (max-width: 820px) { .coal { grid-template-columns: 1fr; } .coal .side { position: static; } }
</style>
