---
import Base from '../layouts/Base.astro';
import { glossary } from '../data/content';
const sorted = [...glossary].sort((a, b) => a[0].localeCompare(b[0], 'sl'));
---
<Base title="Slovar" description="Politični izrazi, razloženi preprosto.">
  <section class="section">
    <div class="wrap">
      <p class="label">Slovar</p>
      <h1>Politični izrazi, preprosto</h1>
      <p class="dek narrow">Besede iz poročil, razložene v enem stavku.</p>
      <input id="q" type="search" placeholder="Išči izraz" aria-label="Išči izraz" />
      <dl id="terms">
        {sorted.map(([t, d, p]) => (
          <div data-s={(t + ' ' + d).toLowerCase()}>
            <dt>{t}</dt>
            <dd><p>{d}</p><p class="small">{p}</p></dd>
          </div>
        ))}
      </dl>
      <p id="none" class="small" hidden>Tega izraza še nimamo. Predlagaj ga na popravki@zabit.si.</p>
    </div>
  </section>
</Base>
<script>
  const q = document.getElementById('q') as HTMLInputElement;
  const rows = document.querySelectorAll<HTMLElement>('#terms > div');
  q.addEventListener('input', () => {
    const v = q.value.trim().toLowerCase();
    let shown = 0;
    rows.forEach((r) => { const ok = !v || r.dataset.s!.includes(v); r.hidden = !ok; if (ok) shown++; });
    document.getElementById('none')!.hidden = shown > 0;
  });
</script>
<style>
  input { width: 100%; max-width: 520px; margin: 28px 0 20px; padding: 12px 16px; font: inherit; border: 1px solid var(--ink); border-radius: 999px; background: #fffefb; }
  input:focus { outline: 3px solid var(--mark); outline-offset: 1px; }
  dl { margin: 0; border-top: 1px solid var(--ink); }
  dl > div { display: grid; grid-template-columns: 280px 1fr; gap: 24px; padding: 18px 0; border-bottom: 1px solid var(--rule); }
  dt { font-family: var(--serif); font-size: 1.35rem; }
  dd { margin: 0; }
  dd p:first-child { font-family: var(--serif); font-size: 1.12rem; margin-bottom: 4px; }
  dd .small { margin: 0; }
  @media (max-width: 720px) { dl > div { grid-template-columns: 1fr; gap: 4px; } }
</style>
